    <script>
        (function () {
            var unlocked = /(?:^|; )av_claim_prep=1(?:;|$)/.test(document.cookie);
            var readyHeader = document.getElementById('claim-prep-ready-header');
            var lockedHeader = document.getElementById('claim-prep-locked-header');
            var ready = document.getElementById('claim-prep-ready');
            var locked = document.getElementById('claim-prep-locked');
            var link = document.getElementById('claim-prep-pdf-link');
            if (unlocked) {
                if (readyHeader) readyHeader.classList.remove('hidden');
                if (lockedHeader) lockedHeader.classList.add('hidden');
                if (ready) ready.classList.remove('hidden');
                if (locked) locked.classList.add('hidden');
                if (link) link.href = '/static/AV-firearm-insurance-claim-prep-checklist.pdf';
            }
            if (link) {
                link.addEventListener('click', function () {
                    if (window.gtag) {
                        gtag('event', 'file_download', { event_category: 'checklist', event_label: 'insurance_claim_prep_pdf' });
                    }
                    if (window.umami) {
                        umami.track('claim_prep_checklist_pdf_download');
                    }
                });
            }
        })();
    </script>
