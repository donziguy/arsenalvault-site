    </main>

    <script>
        (function () {
            var form = document.getElementById('claim-prep-form');
            if (!form) return;
            var errorEl = document.getElementById('claim-prep-error');
            var utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'];

            form.addEventListener('submit', function (event) {
                event.preventDefault();
                if (errorEl) {
                    errorEl.textContent = '';
                    errorEl.classList.add('hidden');
                }
                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }

                var params = new URLSearchParams(window.location.search);
                var data = new FormData(form);
                var portalId = form.getAttribute('data-portal-id') || '';
                var formId = form.getAttribute('data-form-id') || '';
                var region = form.getAttribute('data-region') || 'na2';
                var thanks = new URL('/claim-prep-checklist-thanks.html', window.location.origin);
                utmKeys.forEach(function (key) {
                    var value = params.get(key);
                    if (value) thanks.searchParams.set(key, value);
                });
                var thanksUrl = thanks.pathname + thanks.search;

                function go() {
                    window.location.assign(thanksUrl);
                }

                if (!portalId || !formId) {
                    go();
                    return;
                }

                var fields = [];
                ['email', 'firstname', 'av_firearm_count_band', 'av_signup_source', 'av_lead_magnet', 'checklist_consent'].forEach(function (name) {
                    var value = data.get(name);
                    if (value) fields.push({ name: name, value: String(value) });
                });
                utmKeys.forEach(function (key) {
                    var value = params.get(key);
                    if (value) fields.push({ name: key, value: value });
                });

                var host = region === 'na1' ? 'https://api.hsforms.com' : 'https://api-' + region + '.hsforms.com';
                var button = form.querySelector('button[type="submit"]');
                if (button) button.disabled = true;

                fetch(host + '/submissions/v3/integration/submit/' + encodeURIComponent(portalId) + '/' + encodeURIComponent(formId), {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        fields: fields,
                        context: {
                            pageUri: window.location.href,
                            pageName: document.title
                        }
                    })
                }).then(function () {
                    go();
                }).catch(function () {
                    go();
                });
            });
        })();
    </script>
