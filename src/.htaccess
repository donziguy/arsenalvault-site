Options -Indexes
RewriteEngine On

# Force apex host (Search Console: www returns 200 while canonicals are apex)
RewriteCond %{HTTP_HOST} ^www\.arsenalvault\.com$ [NC]
RewriteRule ^(.*)$ https://arsenalvault.com/$1 [R=301,L,QSA]

# Redirect index.html to clean URLs
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^blog/index\.html$ /blog/ [R=301,L]

# Serve .html files without extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]
