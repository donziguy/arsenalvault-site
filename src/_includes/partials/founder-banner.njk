{% if pricing.showFounderBanner %}
<section id="founder-lifetime" class="max-w-4xl mx-auto mb-12" aria-label="Founder Lifetime">
    <div class="bg-av-dark rounded-2xl p-8 border border-av-gold/40 text-center">
        <p class="text-av-gold text-sm font-semibold mb-2">First 100 members. Closes {{ pricing.founderCloseDate }}.</p>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-white mb-3">Founder Lifetime: $79 once, Pro features for life.</h2>
        <p class="text-gray-300 max-w-2xl mx-auto mb-4">We are offering lifetime Pro to our first 100 members only. One payment, no renewals, insurance PDF reports included. This offer closes {{ pricing.founderCloseDate }}. When the 100 spots are gone, this offer is gone.</p>
        <p class="text-gray-400 text-sm max-w-2xl mx-auto mb-6">Private Vault is not included. Member seats stay at 5. Ultimate features are not included. No transfer or resale.</p>
        <a href="{{ pricing.founderUrl }}" class="inline-block gradient-gold text-av-dark px-8 py-3 rounded-xl font-semibold hover:opacity-90 transition">Claim a founder spot</a>
    </div>
</section>
{% endif %}
