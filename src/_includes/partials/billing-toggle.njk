<div class="flex justify-center mb-4">
    <div class="inline-flex items-center rounded-full border border-gray-200 bg-white p-1 shadow-sm" role="group" aria-label="Billing period">
        <button type="button" data-billing="monthly" aria-pressed="true" class="px-5 py-2 rounded-full text-sm font-semibold gradient-gold text-av-dark">Monthly</button>
        <button type="button" data-billing="yearly" aria-pressed="false" class="px-5 py-2 rounded-full text-sm font-semibold text-gray-600">Yearly ({{ pricing.yearlySavingsLabel }})</button>
    </div>
</div>
<p class="text-center text-gray-500 text-sm mb-10">Yearly plans are billed once a year.</p>
